      "globs": [
        "src/**",
        "content/**",
        "seeds/**",
        "fixtures/**",
        "tests/**",
        "e2e/**",
        "fonts/**",
        "public/**",
        "emails/**",
        "docs/product/**",
        "docs/catalog.md",
        "docs/questions.md",
        "docs/spikes/hebergement-protocole.md",
        "docs/spikes/determinisme-protocole.md",
        "docs/atelier/questionnaire-gate-1.md",
        "docs/da/da-1-preparation.md",
        "spikes/hosting-business/README-SONDE.md",
        "spikes/hosting-business/measure/mesurer.mjs",
        "spikes/hosting-business/probe/.gitignore",
        "spikes/hosting-business/probe/package.json",
        "spikes/hosting-business/probe/package-lock.json",
        "spikes/hosting-business/probe/next.config.mjs",
        "spikes/hosting-business/probe/lib/probe.js",
        "spikes/hosting-business/probe/app/layout.js",
        "spikes/hosting-business/probe/app/page.js",
        "spikes/hosting-business/probe/app/ssr/page.js",
        "spikes/hosting-business/probe/app/image/page.js",
        "spikes/hosting-business/probe/app/api/probe/runtime/route.js",
        "spikes/hosting-business/probe/app/api/probe/env/route.js",
        "spikes/hosting-business/probe/app/api/probe/db/route.js",
        "spikes/hosting-business/probe/app/api/probe/raw/route.js",
        "spikes/hosting-business/probe/app/api/probe/c7/route.js",
        "spikes/hosting-business/probe/app/api/probe/c9/route.js",
        "spikes/hosting-business/probe/app/api/probe/limits/route.js",
        "spikes/hosting-business/probe/public/probe.png",
        "docs/ADR/0001-*.md",
        "docs/ADR/0002-*.md",
        "docs/ADR/0004-*.md",
        "README.md",
        ".gitignore",
        "package.json",
        "tsconfig.json",
        "next.config.ts",
        "vitest.config.mts",
        ".github/**",
        "scripts/check-boundaries.mjs"
      ]
    },
    "audit": {
      "status": "active",
      "lintTerms": false,
      "source": "§24.6 zone documentaire d'audit (Master Plans, audit, CHANGELOG)",
      "globs": [
        "docs/audit/**",
        "docs/master-plan/**",
        "docs/CHANGELOG.md"
      ]
    },
    "shared-core": {
      "status": "inactive",
      "lintTerms": true,
      "source": "§24.6 / P2 D2 : Shared Core conditionnelle, jamais implicite ; aucune mutualisation décidée",
      "globs": []
    }
  },
  "exclusions": [
    {
      "glob": "scripts/forbidden-terms.mjs",
      "reason": "Implémentation du lint des termes interdits",
      "source": "P14 D1, D3 ; ADR-0002"
    },
    {
      "glob": "scripts/forbidden-terms.config.json",
      "reason": "Liste normative canonique des motifs interdits",
      "source": "P14 D1, D3, D5 ; ADR-0002"
    },
    {
      "glob": "scripts/forbidden-terms-samples/**",
      "reason": "Échantillons nécessaires au test du lint lui-même",
      "source": "P14 D1, D3 ; ADR-0002"
    },
    {
      "glob": "package-lock.json",
      "reason": "Fichier généré par npm (arbre de dépendances tierces), non rédigé ; aucun contenu produit",
      "source": "P2 D3 (exclusion explicite justifiée) ; ADR-0002 — À CONFIRMER par le Supervisor"
    }
  ]
}
