      "globs": [
        "src/**",
        "content/**",
        "seeds/**",
        "fixtures/**",
        "tests/**",
        "e2e/**",
        "fonts/**",
        "public/**",
        "emails/**",
        "docs/product/**",
        "docs/catalog.md",
        "docs/questions.md",
        "docs/spikes/hebergement-protocole.md",
        "docs/spikes/determinisme-protocole.md",
        "docs/atelier/questionnaire-gate-1.md",
        "docs/da/da-1-preparation.md",
        "docs/phase-2/preparation-domain-model.md",
        "docs/ADR/0001-*.md",
        "docs/ADR/0002-*.md",
        "docs/ADR/0004-*.md",
        "docs/ADR/0003-hebergement.md",
        "docs/ADR/0005-determinisme-geometrie.md",
        "README.md",
        ".gitignore",
        "package.json",
        "tsconfig.json",
        "next.config.ts",
        "vitest.config.mts",
        "vitest.db.config.mts",
