{
  "version": 1,
  "source": "Master Plan v1.5 §4.3, §24.6 ; arbitrages P2 et P14 ; ADR-0002",
  "patterns": [
    "\\bpvc\\b",
    "\\bverres?\\b",
    "\\bglass(ware)?\\b",
    "\\bglassora\\b",
    "\\bd[ée]coupe[_ -]?m[ée]tal\\b",
    "\\bmetal[_ -]?cut(ting)?\\b"
  ],
  "zones": {
    "strict-product": {
      "status": "active",
      "lintTerms": true,
