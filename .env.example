# Modèle SANS SECRET. Copier en `.env.local` (ignoré par Git) et choisir des valeurs locales.
# Ne jamais y placer de valeur Hostinger.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=maplaquepro_local
MARIADB_USER=maplaquepro
MARIADB_PASSWORD=
# mysql://<utilisateur>:<mot_de_passe>@127.0.0.1:3307/<base>
DATABASE_URL=

# S2 — compte client
# Origine des liens envoyés par email (jamais déduite de l'en-tête Host).
APP_URL=http://localhost:3000
# memoire | fichier (.local/outbox) — développement uniquement ; aucun fournisseur d'email arbitré pour la production
EMAIL_TRANSPORT=fichier
